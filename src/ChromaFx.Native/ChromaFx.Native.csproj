<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>ChromaFx.Native</Title>
    <Authors>Ho Tzin Mein</Authors>
    <Description>Optional native still-image WebP, AVIF, and JPEG XL codecs for ChromaFx. Not in the meta-package. Animated WebP/AVIF/JPEG XL are not supported.</Description>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Ho Tzin Mein</Copyright>
    <RepositoryUrl>https://github.com/chromafx/chromafx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image graphics webp avif jxl jpegxl codec native imageprocessing dotnet csharp chromafx</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <Content Include="runtimes\**\*" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChromaFx.IO\ChromaFx.IO.csproj" />
  </ItemGroup>
</Project>
