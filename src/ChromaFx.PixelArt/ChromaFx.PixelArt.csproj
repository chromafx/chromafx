<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>ChromaFx.PixelArt</Title>
    <Authors>Ho Tzin Mein</Authors>
    <Description>Pixel-art upscaling and rotation for ChromaFx. Scale2x (EPX), Eagle/SaI families, Scale4x/Scale8x, and RotSprite-style RotateSprite.</Description>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Ho Tzin Mein</Copyright>
    <RepositoryUrl>https://github.com/chromafx/chromafx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image graphics bitmap pixelart scale2x epx eagle sai 2xsai rotsprite upscaling rotation imageprocessing dotnet csharp chromafx</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChromaFx.Core\ChromaFx.Core.csproj" />
    <ProjectReference Include="..\ChromaFx.Processing\ChromaFx.Processing.csproj" />
  </ItemGroup>
</Project>
