<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Pack explicitly (CI/release via `dotnet pack`); keep everyday builds fast. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!--
      Single version line for all projects.
      Local / unset CI: 0.6.1-local (after last tagged 0.6.0; never publish this)
      CI non-tag (master/PR): set /p:Version=0.6.1-ci.$GITHUB_RUN_NUMBER (not published)
      Tags vX.Y.Z: set /p:Version=X.Y.Z (strip leading v) — only tags publish to nuget.org
    -->
    <Version Condition="'$(Version)' == ''">0.6.1-local</Version>

    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://chromafx.net</PackageProjectUrl>
    <PackageReleaseNotes>0.6.0: PixelArt Scale3x, HQX, CleanEdge / CleanEdgeRotate; tag-only NuGet releases. See CHANGELOG.md. API may still change before 1.0 (0.x).</PackageReleaseNotes>
  </PropertyGroup>
</Project>
